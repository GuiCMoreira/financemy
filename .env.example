# Senha única de acesso. Sem ela a aplicação não libera nenhuma tela.
# Use algo longo e exclusivo deste projeto — trocar a senha encerra todas as
# sessões ativas, o que é o comportamento desejado se suspeitar de vazamento.
SENHA_ACESSO="troque-por-uma-senha-longa-e-unica"

# Desenvolvimento local — sobe com `npm run db:up`
DATABASE_URL="postgresql://caixa:caixa@localhost:5434/caixa?schema=public"

# Produção com pooler (Supabase, Neon): DATABASE_URL aponta para o pooler
# (transaction mode) e DIRECT_URL para a conexão direta, usada pelas migrations.
# DIRECT_URL="postgresql://..."
